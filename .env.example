# ==============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE - API GATEWAY
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais locais:
#   cp .env.example .env

# --- Banco de Dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apigateway
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=10

# --- Autenticação Administrativa (/admin/*) ---
ADMIN_API_KEY=your_admin_api_key_here

# --- Segurança JWT (HMAC-SHA256) ---
JWT_SECRET=your_jwt_secret_key_here
JWT_ISSUER=apigateway

# --- Service Discovery (Eureka) ---
EUREKA_URL=http://localhost:8761/eureka
EUREKA_APP_NAME=API-GATEWAY
INSTANCE_HOST=localhost
PORT=8080
EUREKA_REGISTER=true
EUREKA_REFRESH_INTERVAL=10
EUREKA_HEARTBEAT_INTERVAL=30
EUREKA_ENABLED=true

# --- Cache & Rate Limiting (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# --- Resiliência (Circuit Breaker & Retry) ---
CB_FAILURE_THRESHOLD=5
CB_OPEN_DURATION_MS=10000
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=100
